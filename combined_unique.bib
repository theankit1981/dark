@article{WOS:000305400900007,
 abstract = {The popularity of Facebook and other online social-networking sites has
led to research on the potential risks of use, including Internet
addiction. Previous studies have reported that between 8 percent and 50
percent of college students report problems consistent with Internet
addiction. The current study assessed a range of variables related to
Facebook use, and sought to determine how the use of Facebook relates to
problematic Internet use. Undergraduate participants (N=281, 72 percent
women) completed a battery of self-report measures, including the
Internet Addiction Test, via an online interface. The results of the
current study suggest that a sizable minority of students experience
problems related to Internet use and that the use of Facebook may
contribute to the severity of symptoms associated with Internet
addiction.},
