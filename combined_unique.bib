@article{WOS:000797251800011,
 abstract = {Problematic usage of the Internet (PUI) is an umbrella term covering a
range of problematic behaviors including online addictive behaviors,
such as gaming disorder, pornography use disorder, buying-shopping
disorder, and problematic social networks use. Theoretical models of PUI
can not only inspire research on psychological and neurobiological
mechanisms but may also inspire clinical practice. Based on specific
examples of theoretical models of PUI and specific subtypes of PUI, we
