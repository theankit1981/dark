@article{WOS:001260724300002,
 abstract = {Influenced by the pandemic in 2020, `in-home restrictions' promoted live
stream shopping. As a new type of social e-commerce, live stream
shopping has an increasingly important role in social interaction.
Another significant feature of live stream shopping is the availability
of price discounts. Based on the basic social and commercial attributes
of live stream shopping, this study aims to investigate the effects of
loneliness on perceived interaction, perceived price discount, and
customers' purchase intention. This study conducted an online
large-sample survey (n = 9,072) for data collection. The results show
that loneliness positively influences customers' purchase intention. And
streamer-viewer interaction, interactions among live stream room viewer
members, and price discount perception play a mediating role in
loneliness and purchase intention. This study has implications for the
live stream shopping industry. It helps business managers to focus on
consumer psychology and social interaction factors better.},
