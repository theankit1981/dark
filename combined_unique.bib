@article{WOS:000238379400007,
 abstract = {We explore the role of negative relationships in the context of social
networks in work organizations. Whereas network researchers have
emphasized the benefits and opportunities derived from positive
interpersonal relationships, we examine the social liabilities that can
result from negative relationships in order to flesh out the entire
``social ledger.{''} Deriving our argument from theory and research on
negative asymmetry, we propose that these negative relationships may
have greater power than positive relationships to explain workplace
outcomes.},
