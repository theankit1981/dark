 affiliation = {Arslan, N (Corresponding Author), Saglik Bilimleri Univ, Gulhane Fac Hlth Sci, Dept Nutr \& Dietet, TR-06010 Ankara, Turkiye.
Arslan, Neslihan, Saglik Bilimleri Univ, Gulhane Fac Hlth Sci, Dept Nutr \& Dietet, TR-06010 Ankara, Turkiye.
