@article{WOS:001465009200001,
 abstract = {This longitudinal study investigated the relationship between fear of
missing out (FoMO) and problematic social media use (PSMU), considering
the mediation effects of social media self-control failure (SMSCF). In
testing the hypotheses proposed in this study, we separately examined
between-person effects and within-person effects in multilevel mediation
models. Based on a three-wave survey of 520 university students (M-age =
20.25 +/- 1.83, 136 males), the results showed that trait-FoMO and
state-FoMO not only had positive direct effects on PSMU but also
positive indirect effects on PSMU via SMSCF at the between-person and
within-person levels. This study contributes to the PSMU literature by
clarifying the mechanisms linking FoMO and SMSCF to PSMU, as well as its
practical and theoretical implications for research on prevention and
intervention of PSMU.},
