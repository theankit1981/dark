@article{WOS:000580609900003,
 abstract = {Despite the increasing use of social media, very little is known about
its consequences for students of graduate research training. The purpose
of this study is to look into the outcomes of social media usage while
answering when and how the use of social media may lead to students'
creativity and engagement. Primary data were collected from 383 research
students studying in different universities in eastern China. Findings
reveal that students' use of social media is related to their creativity
and engagement in graduate research training through knowledge sharing
behavior. In addition, cyberbullying was found to play the role of
boundary condition such that the mediated relationships are weak for the
students facing more cyberbullying. Limitations and future directions,
as well as implications for research and practice, are discussed.},
