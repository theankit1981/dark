@article{WOS:000480492100001,
 abstract = {Purpose: Studies with experimental designs in which the association
between participants' subjective well-being and their use of social
media is studied remain rare. This study tested the effect of abstaining
from social media use on participants' well-being, affect, perceived
stress, and sense of perceived loneliness. Design and Methods:
Randomized, controlled design. Sixty-eight participants were randomized
to one of two conditions. Findings: Those who abstained from social
media use, compared with those in the control group, evidenced a decline
in life satisfaction, an increase in negative affect, and an increase in
loneliness.},
