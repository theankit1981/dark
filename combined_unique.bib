@article{WOS:001313500000001,
 abstract = {Introduction: This study explored sharenting's ` s impact on children's
` s privacy and factors influencing fl uencing parental sharing. Limited
knowledge raises concerns about children's ` s rights in this growing
phenomenon. Method: A quasi-experimental cross-sectional study included
411 parents (372 females, 39 males) with a mean age of 38.5 10.5 years.
Chi-square tests analyzed group differences; regression assessed the ``
sharenting practice{''} `` impact. Results: Out of 411 parents, 67.2\%
(n = 247) shared photographs of their children on social media, whereas
32.8\% (n = 164) did not share. Significant fi cant associations were
found between sharenting and factors such as younger age (B =- 0.06, p =
.002), lower bachelor's ` s degree level (B = 0.87, p < .001), higher
internet addiction (B = 0.05, p < .001), and longer social media use (B
= 0.17, p < .001). Discussion: Understanding factors in sharenting's ` s
impact on children's ` s rights is crucial. Our fi ndings suggest
sociodemographic factors, internet addiction, and social media duration
influence fl uence sharenting. Health professionals can guide parents on
responsible social media usage and digital literacy to protect their
children's ` s online privacy. J Pediatr Health Care. (2024) 38, 643-650
- 650},
