@article{WOS:000394241000024,
 abstract = {Influence problem is one of the central problems in the study of online
social networks, the goal of which is to influence all nodes with the
minimum number of seeds. However, in the real world, it might be too
expensive to influence all nodes. In many cases, it is satisfactory to
influence nodes only up to some percent p. In this paper, we study the
minimum partial positive influence dominating set (MPPIDS) problem. In
fact, we presented an approximation algorithm for a more general problem
called minimum partial set multicover problem. As a consequence, the
MPPIDS problem admits an approximation with performance ratio , where is
the Harmonic number, , and are the maximum degree and the minimum degree
of the graph, respectively. For power-law graphs, we show that our
algorithm has a constant performance ratio.},
