@article{WOS:000795732200001,
 abstract = {Set in a French higher education context, this paper contributes to the
knowledge management literature by arguing that the digital
transformation of knowledge transfer via distance learning includes
negative outcomes, in addition to many benefits. Based on quantitative
and qualitative data, via an online survey from learners and
instructors, our findings show that while online modes of delivery are
convenient and cost-effective, they overlook many aspects that enable
