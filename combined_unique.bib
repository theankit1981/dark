@article{WOS:000574656800002,
 abstract = {Based on the background of current information era and the important
role of body image in the health and well-being of female adolescents,
this study aimed to investigate the moderating role of body image
flexibility on the association between photo-related activities on SNS
(social networking site) and body dissatisfaction among female
adolescents in China. A total of 646 female adolescents were recruited
to complete a set of questionnaires concerning the photo-related
activities on WeChat Moments (the most widely used SNS in China), body
image flexibility, and body dissatisfaction. The results showed that
photo-related activities were positively associated with body
dissatisfaction, and body image flexibility could significantly moderate
this association, with a more significant effect for individuals with
low levels of body image flexibility. This study not only contributes
Chinese data and findings to this research theme, but also deepens our
understanding by investigating the moderating mechanism; the results
were also discussed in terms of limitations and implications.},
