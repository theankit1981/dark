@article{WOS:000892832600001,
 abstract = {This study examined two ways of using the TikTok application (active vs.
passive use), and their association with female users' self-esteem
pertaining to appearance and weight. By adopting a cross-sectional
online survey design, this study recruited 7,750 adult female TikTok
users from China (Douyin), and acquired self-reported data on 2 ways of
using TikTok, state-level social comparison, appearance-esteem,
weight-esteem, body mass index, and age. The results indicated that
passive and active TikTok uses were negatively and positively associated
with participants' appearance- and weight-esteem, respectively. A
mediation analysis revealed that the participants' state-level social
comparison while using TikTok mediated the association between two ways
of TikTok use, and their effects on appearance- and weight-esteem. These
