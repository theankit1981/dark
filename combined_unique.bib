Casale, Silvia, Univ Florence, Florence, Italy.
Su, Chang, Brandon Univ, Brandon, MB R7A 6A9, Canada.
Flett, Gordon L., York Univ, LaMarsh Ctr Child \& Youth Res, Dept Psychol, Toronto, ON, Canada.},
 affiliations = {York University - Canada; University of Florence; Brandon University;
York University - Canada},
 author = {Flett, Gordon L. and Casale, Silvia and Stoakes, Alysha and Nepon, Taryn
and Su, Chang},
