@article{WOS:000752111100001,
 abstract = {The setting of the current study was an urban city where the majority of
public housing residents are single females living in poverty. An
adapted women's mindfulness program, including a Photovoice exercise,
was offered to this vulnerable population. Stress contributes to poor
mental/physical health. A Photovoice research method was used to
elucidate the stressors and coping facilitators used by participants.
Eleven participants took a digital photography workshop and then
photographed stressors and coping facilitators. All 275 photographic
submissions were analyzed thematically. Coping themes were: Aesthetics:
Man-Made and Natural; Relationships: Pets and People; Self-Esteem and
Cultural Identity; and Inspiration Through Religion and Social Media
Messaging. Stress themes were: Urban Disarray and Existential
Threat/Danger. Results showed that social connectedness, spirituality,
improving neighborhood aesthetics, use of social media, and access to
nature could support coping.},
