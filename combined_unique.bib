@article{WOS:001014777800001,
 abstract = {Facebook has grown to be one of the most widely used communication
platforms. A new condition linked with widespread use has emerged with
its expanding popularity: Facebook addiction. A descriptive
cross-sectional research design was used in the current study, in two
randomly selected villages (Elmanial and Batra) and one town (Talkha
city) affiliated with Dakahlia Governorate, Egypt. Data were collected
from women only through using a self-administered socio-demographic
questionnaire, Facebook addiction scale, Beck depression inventory-II,
and emotional regulation scale. The study found 83.7\% of the studied
women reported moderate emotional regulation; 27.9\% had moderate
Facebook addiction, and 23.9\% reported mild depression. The study
concluded there was a significant negative correlation between Facebook
addiction and emotional regulation.},
