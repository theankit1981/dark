@article{WOS:000652980700003,
 abstract = {In recent years, the new media have become so attractive that they are
used for meetings, entertainment, and work. People more and more often
use Facebook or phones instead of doing their work or family duties. The
main aim of the present study was to test the mediating role of future
anxiety in the relationship between procrastination and problematic new
media use. The participants were students (N = 478), aged 18 to 27 (M =
19.93, SD = 1.77); 64\% of the sample were women. The General
Procrastination Scale, the Decisional Procrastination Scale, the
