@article{WOS:000770652700006,
 abstract = {In this review, we systematize work on the relationship be-tween social
media use and stress by providing a functional perspective that
distinguishes between three functions that social media can have in the
stages of the stress-coping pro-cess: as stressors, as resources, and as
coping tools. Current research provides evidence that social media can
cause stress, serve as resources, and can be used as a tool for various
coping strategies, but it remains unclear when social media can
successfully mitigate stress. Future research should use more
fine-grained research designs that consider the timing of social media
use, the situational context, and the encountered content to determine
when social media serves which function and when social media reduces or
increases stress.},
