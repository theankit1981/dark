@article{WOS:000318229200021,
 abstract = {This study examined the moderating role of attachment anxiety on the
relationship between intensity of social network site use and bridging,
bonding, and maintained social capital. Data from 322 undergraduate
Chinese students were collected. Hierarchical regression analyses showed
positive relationships between online intensity of social network site
use and the three types of social capital. Moreover, attachment anxiety
moderated the effect of intensity of social network site use on social
capital. Specifically, for students with lower attachment anxiety, the
relationships between intensity of social network site use and bonding
and bridging social capital were stronger than those with higher
attachment anxiety. The result suggested that social network sites
cannot improve highly anxiously attached individuals' social capital
effectively; they may need more face-to-face communications.},
