@article{WOS:000922740800001,
 abstract = {In order to explore the direct connection between financial technology
and digital financial risk management, this paper combines intelligent
data processing methods to apply financial technology to digital
financial risk management, and analyzes it by taking Internet finance as
an example. In order to establish a hypernetwork model consisting of
capital owners, Internet financial intermediaries, traditional financial
intermediaries, and capital demanders. In addition, this paper
introduces the credit penalty function and the operational risk function
to build an Internet financial super-network model considering the
relationship level, so as to study the general equilibrium state of the
integrated super-network composed of social networks and Internet
financial networks. The experimental research results show that there is
a certain correlation between financial technology and digital financial
risk management, so we should pay attention to the application of
financial technology in digital financial risk management while
developing digital finance.},
