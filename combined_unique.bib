@article{WOS:000427675400006,
 abstract = {This study deals with the phenomenon of air pollution in China, focusing
on the relative influence of media use and risk perception on public
trust in local governments. In particular, risk perception is specified
as perceived dread and perceived inequality. Detailed analyses of the
survey data showed that perceived dread partially mediated the positive
impact of the use of news media or social media on public trust in local
governments. Specifically, the mediating effects were stronger when the
public's perceived inequality regarding risk distribution was high than
when their perceived inequality was low. The findings shed light on how
perceived dread and perceived inequality bridge and condition the impact
of media use on public trust in local governments in China, thus
highlighting the role of risk perception in the mechanism of political
trust in the context of environmental risks.},
