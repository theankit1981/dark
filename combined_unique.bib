@article{WOS:001506585300001,
 abstract = {The social compensation hypothesis posits that individuals with reduced
social functioning and connectivity may use social media to compensate
for real-life social deficiencies. Based on this theoretical framework,
the present study tested the mediating role of relatedness need
frustration in the association between the need to belong and
problematic social media use severity. A hybrid data collection
procedure was applied using an address-based sampling method to obtain a
nationally representative sample of Hungarian adults (N = 807; 53.41\%
women, M-age = 46.61 years, SD = 16.58, age range = 18-86). Partial
mediation was found, indicating that higher levels of need to belong
were both directly and indirectly associated with problematic social
media use severity through relatedness need frustration. These findings
underline the importance of fostering satisfying social relationships to
prevent problematic engagement with online social spheres.},
