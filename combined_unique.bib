@article{WOS:001001758600001,
 abstract = {Social media has been classified as a new form of addiction. The aim of
the current systematic review was to analyze social media's impact on
body image and wellbeing among adolescents and young adults. Twenty-one
articles published from 2015 to April 2020 were analyzed. Misuse or
intensive use of social media was related to body dissatisfaction, low
self-esteem, risky behaviors, and eating disorders. Information
