@article{WOS:001563971300001,
 abstract = {Social isolation, a common challenge for older adults, could cause
various adverse outcomes, especially for those in China with limited
digital skills. However, few studies have investigated its individual
influencing factors, particularly older adults' self-aging attitudes, in
the current digital era. The current study aimed to investigate whether
and how self-aging attitudes were associated with social isolation among
Chinese older adults by proposing a serial mediation model, with
internet self-efficacy and social media use serving as mediators. A
total of 459 Chinese older adults were randomly selected to participate
in this study. Self-aging attitudes, social isolation, internet
self-efficacy, and active social media use were measured using the
Attitudes to Aging Questionnaire, Lubben Social Network Scale, Internet
Self-efficacy Scale, and Surveillance Use Scale of Facebook Use,
respectively. Statistical analysis included Pearson correlation and
serial mediation effect analysis. The results showed that the proposed
serial mediation model was supported: (1) Self-aging attitudes were
negatively associated with social isolation; (2) Internet self-efficacy
and active social media use functioned as serial mediators. In
conclusion, promoting positive self-aging attitudes is an effective
strategy for alleviating older adults' social isolation, as it enhances
internet self-efficacy and encourages active social media use.},
