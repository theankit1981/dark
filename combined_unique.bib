@article{WOS:000222999400017,
 abstract = {This study builds on research addressing intergenerational ambivalence
by considering emotional ambivalence toward the wider social network.
Men and women ages 13 to 99 (N = 187) completed diagrams of their close
and problematic social relationships. Social ties were classified as
solely close, solely problematic, or ambivalent, based on network
placement (n = 3,392 social contacts). Multilevel models revealed that
individuals viewed certain close familial ties (e.g., spouse, son or
daughter, parent, sibling) with greater ambivalence than they viewed
more distal family, ties, friendships, or acquaintances. Participants
classified more acquaintances than other relationships as solely
problematic. Feeling closer to a social partner was associated with
increased ambivalence. Older adults were more likely to classify their
relationships as solely close than as ambivalent, in comparison with
younger adults. Discussion focuses on tension and closeness in familial
and nonfamilial relationships.},
