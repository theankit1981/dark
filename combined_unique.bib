@article{WOS:001540199000001,
 abstract = {The use of social media in the workplace has significantly impacted
employees' job performance. Previous studies have highlighted the dual
nature of social media's impact on job performance; however, the
conditions under which this dichotomy coexists have largely remained
unexplored. Drawing on the conservation of resource theory (COR), this
research examines the relationship between two types of social
networking site (SNS) usage - task-oriented and relationship-oriented -
and job performance to explain this duality. Moreover, we examine the
mediating role of cyberbullying victimisation and emotional exhaustion,
along with the moderating role of digital leadership, to elucidate the
relationship between SNS usage and job performance. The data were
collected from employees across various organisations in Islamabad,
Pakistan, using the daily diary method, with both employees and their
supervisors participating in the survey. The data were analysed using
multilevel structural equation modelling. The results revealed that
task-oriented and relationship-oriented SNS usage were differently
related to job performance. Moreover, these relationships were mediated
by cyberbullying victimisation and emotional exhaustion. The findings
also indicated that digital leadership negatively moderated the
relationship between both types of SNS usage and cyberbullying
victimisation. The findings offer critical theoretical and practical
contributions.},
 address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OR14 4RN, OXON, ENGLAND},
