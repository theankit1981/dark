@article{WOS:001518897200001,
 abstract = {Mental distress is associated with problematic social media use (PSMU).
However, research has rarely discussed the relationship with the
consideration of different types of PSMU (i.e., generalized PSMU and
specific forms of PSMU) across countries. Therefore, the present study
compared different types of PSMU between Indonesian and Taiwanese
university students and their associations with mental distress. Using a
cross-sectional online survey, 1402 university students from Indonesia
(mean age = 20.02 years {[}SD +/- 1.48]; 411 females {[}79.8\%]) and
Taiwan (mean age = 28.82 years {[}SD +/- 6.06]; 565 females {[}63.7\%])
completed measures assessing generalized PSMU (i.e., Bergen Social Media
Addiction Scale {[}BSMAS]), specific problematic YouTube use (i.e.,
YouTube Addiction Scale {[}YAS]), and mental distress (i.e., Depression,
Anxiety and Stress Scale-21 {[}DASS-21]). Indonesian students had higher
levels of generalized PSMU (16.30 +/- 4.19 vs. 14.83 +/- 5.19; p <
0.001) but lower specific problematic YouTube use (12.76 +/- 3.77 vs.
14.43 +/- 5.04; p < 0.001) than Taiwanese students. Moreover, multiple
linear regressions showed that mental distress, especially depression,
significantly explained generalized PSMU and specific problematic
YouTube use. Based on the present findings, healthcare providers may
want to help university students find appropriate methods to cope with
their mental distress, which may in turn, lower their generalized PSMU
and specific problematic YouTube use.},
