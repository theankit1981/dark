@article{WOS:000407186500053,
 abstract = {could buffer the deleterious impact of stress on mental health. Recent
studies show that college students are likely to engage in
self-disclosure on social network sites (SNSs), but it is unclear to
what extent they benefit from doing that. This study examined the effect
of self-disclosure on SNSs on young adults' mental health. Survey data
were collected from a probability sample of 560 university students. The
results show that people tend to open up on Facebook when in times of
stress and that self-disclosure on Facebook moderates the relationship
between stressful life events and mental health. Facebook disclosure was
also positively associated with enacted social support on Facebook,
which led to increased perceived social support, enhanced life
satisfaction, and reduced depression. SNSs, therefore, serve as a
promising avenue for delivering health care and intervention. (C) 2017
Elsevier Ltd. All rights reserved.},
