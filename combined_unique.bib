Koyanagi, Ai; Tyrovolas, Stefanos; Maria Haro, Josep, Univ Barcelona, CIBERSAM, Fdn Sant Joan de Deu, Parc Sanitari Sant Joan de Deu, Barcelona, Spain.},
 affiliations = {University of Southern Denmark; University of Barcelona; CIBER - Centro
de Investigacion Biomedica en Red; CIBERSAM},
