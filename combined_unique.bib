@article{WOS:000627919300001,
 abstract = {Celebrities are well-known individuals who receive extensive public and
media attention. There is an increasing body of research on the effect
of celebrities on body dissatisfaction and disordered eating. Yet, there
has been no synthesis of the research findings. A systematic search for
research articles on celebrities and body image or eating disorders
resulted in 36 studies meeting inclusion criteria. Overall, the
qualitative, correlational, big data, and experimental methodologies
used in these studies demonstrated that exposure to celebrity images,
appearance comparison, and celebrity worship are associated with
maladaptive consequences for individuals' body image.},
