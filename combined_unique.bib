@article{WOS:001521453300001,
 abstract = {We investigate the impact of geopolitical risk on bank stability in an
emerging economy, India, and how the social networks of bank CEOs affect
this relationship. Our findings establish a negative relationship
between geopolitical risk and bank stability. However, well-connected
CEOs mitigate these adverse effects through their social network,
enhancing bank stability during geopolitical crises. Additionally, bank
heterogeneity analysis highlights the roles of size, diversification,
