University of Illinois Chicago; University of Illinois Chicago Hospital},
 author = {Verner Venegas-Vera, A. and Colbert, Gates B. and Lerma, V, Edgar},
 author-email = {verner.venegas@gmail.com},
 da = {2025-10-14},
