@article{WOS:001550316100001,
 abstract = {Previous research has shown that passive social networking usage (PSNU)
can contribute to adolescents' body image concerns (BIC). A reciprocal
relationship is believed to exist, where increased PSNU heightens BIC,
which, in turn, drives further PSNU. While physical appearance
comparison (PAC) is believed to play a key role in this dynamic, it
remains underexplored. This study examined the reciprocal relationship
between PSNU and BIC in adolescents, with a focus on the mediating role
of PAC, and compared patterns between Vietnamese and Taiwanese students.
A two-wave longitudinal survey was conducted with 957 adolescents (456
in Taiwan and 501 in Vietnam). Guided by Social Comparison Theory and
Cognitive Dissonance Theory, the findings revealed a reciprocal
association between PSNU and BIC over time, with PAC serving as a
significant mediator in both cultural contexts. However, the specific
mediating patterns varied between countries. These results highlight the
importance of psychological support programs that help adolescents
navigate body image concerns and social media use. Study limitations are
