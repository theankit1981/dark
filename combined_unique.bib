 affiliation = {Meshi, D (Corresponding Author), Michigan State Univ, Dept Advertising \& Publ Relat, E Lansing, MI 48824 USA.
Meshi, Dar; Molina, Maria D., Michigan State Univ, Dept Advertising \& Publ Relat, E Lansing, MI 48824 USA.},
