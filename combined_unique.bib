@article{WOS:001348653300007,
 abstract = {Despite the research increase on Problematic Social Media Use (PSMU),
few studies focus on Problematic Instagram Use (PIU) and its associated
factors. Our study evaluated the effects of social comparison (abilities
and opinions) and self-esteem on PIU, mediated by positive and negative
affect. A total of 976 Brazilian university students participated
answering the following scales online: The Iowa-Netherlands Comparison
Orientation Measure, Bergen Facebook Addiction Scale adapted for
Instagram, Positive and negative Affect Schedule and Rosenberg
Self-Esteem Scale. We observed positive associations between social
comparison and negative affect with PIU, and negative associations
between self-esteem and positive affect with the outcome. Based on
structural equation modeling controlling for gender and self-report of
mental health disorders, we observed that negative affect completely
mediated the effects of self-esteem on PIU but did not mediate the
association with social comparison. However, abilities comparison had a
direct effect on PIU. Positive affect did not mediate this associations.
Thus, subjects with higher social comparison of abilities and negative
affect associated with lower self-esteem are more likely to present PIU.
These findings contribute to understanding PIU, considering the users'
