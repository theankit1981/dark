@article{WOS:000455107900003,
 abstract = {Using a dataset of Chinese listed companies, this article quantizes the
centrality of interlocking director network based on the social network
analysis and examines the effect of interlocking director network on
corporate risk taking. The empirical results find that when interlocking
director networks have a high centrality, network members are more
likely to imitate risk-taking behaviors. Marketization and investment
opportunities have positive moderating effects, indicating boundary
