@article{WOS:001552167100001,
 abstract = {This study examines the connection between social anxiety and social
network service (SNS) addiction among college students in Northeast
China, a region with low economic growth. It also explores how
depressive symptoms mediate this relationship. Analyzing data from 2917
students using SPSS 26.0 and Process V.4.0, the study reveals that
higher social anxiety levels correlate with an increased tendency for
SNS addiction. Furthermore, depressive symptoms partially mediate this
relationship, implying that elevated social anxiety leads to greater
depressive symptoms and subsequently enhances SNS addiction. The study
provides practical recommendations for addressing SNS addiction among
college students in Northeast China.},
