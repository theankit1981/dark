@article{WOS:001539645200001,
 abstract = {A range of negative mental health outcomes has been associated with the
use of highly visual social networking sites (HVSNSs), such as
Instagram. This study aimed to test the efficacy of the Social Media
Aware program, a cognitive therapy-based e-learning microintervention
designed to reduce the potential negative impact of HVSNS use on body
satisfaction and well-being. A randomized controlled trial was
conducted, whereby participants (n = 167; Mage = 25.06, SD = 9.36, range
= 16-68; 70.1\% female) were randomly allocated to an intervention group
that watched the 13-min Social Media Aware video before engaging in a
10-min passive Instagram exposure task, or a control group that viewed a
10-min educational video on the history of Instagram before the passive
Instagram exposure task. Participants completed measures at three time
points; immediately prior to intervention, immediately following the
intervention and passive Instagram exposure task, and 3 days following
the intervention. Outcomes included body satisfaction, emotional
well-being (positive and negative affect), and cognitive well-being
(life satisfaction). Additional outcomes included negative automatic
thoughts (NATs; believability and frequency) and social comparison
orientation. Modest, statistically significant improvements in the
desired directions were found for negative affect, positive affect,
satisfaction with life, body satisfaction, and the frequency and
believability of NATs among those who received the intervention compared
to the control group across the two time points. No effect of moderation
of social comparison orientation nor mediation via NATs was shown. These
findings suggest that cognitive restructuring techniques may be useful
in managing the psychological impacts of HVSNS use.},
 address = {750 FIRST ST, NE, WASHINGTON, DC 20002-4242 USA},
 affiliation = {Herriman, Z (Corresponding Author), Univ Adelaide, Fac Hlth \& Med Sci, Sch Psychol, Level 7,Hughes Bldg, Adelaide, SA 5005, Australia.
