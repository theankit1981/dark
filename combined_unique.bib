@article{WOS:000516827400254,
 abstract = {This research examines the mediating role of the tendency for Internet
addiction, fear of missing out (FOMO), and psychological well-being in
the relationship between online exposure to movement-related information
and support for radical actions. A questionnaire survey that targets
tertiary students was conducted during the Anti-Extradition Law
Amendment Bill (Anti-ELAB) Movement (N = 290). The findings reveal the
mediating effect of Internet addiction and depression as the main
relationship. These findings enrich the literature of political
communication by addressing the political impact of Internet use beyond
digital architecture. From the perspective of psychology, this research
echoes the literature that concerns depression symptoms driven by a
protest environment. Radical political attitudes driven by depression
during protests should also be concerned based on the findings of this
survey.},
