@article{WOS:001087802900001,
 abstract = {In the present times, there is a high influence caused by social media
platforms in case of body image issues faced by an individual. Pregnancy
is a stage for women where they go through several mental and physical
changes. Realizing the inseparable role played by social media in this
aspect, it is an attempt here to determine the effect caused by social
media on the body image of pregnant women as well for those in their
post-partum stages. The PRISMA method is used by the authors to arrive
at 55 research papers from the Scopus databases that are systematically
reviewed. The authors' review reveals that social media can have both
negative and positive effects on women's perception of body image during
pregnancy and the postpartum period.},
