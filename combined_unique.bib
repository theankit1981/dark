@article{WOS:001459311700001,
 abstract = {The present study employed a network analysis approach to explore
interrelationships among love addiction, attachment anxiety, attachment
avoidance, and interpersonal dependence. The sample included 80 couples
(N = 160) in romantic relationships, assessed longitudinally through
online self-reports at the study's initiation and three months later.
The findings revealed that attachment anxiety correlated strongly with
low self-confidence, attachment avoidance related to autonomy, and love
addiction showed a positive association with emotional dependence but a
negative association with attachment avoidance. These findings
underscore the associations among love addiction, insecure attachment
patterns, and dimensions of interpersonal dependence. Addressing the
core link between love addiction and insecure attachment patterns may
enhance the psychological well-being of both partners in a couple.},
