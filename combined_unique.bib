@article{WOS:000346819000027,
 abstract = {The present work aimed to study, from the uses and gratifications
paradigm, the uses that Spanish university students (N = 221) do of the
social networking site Tuenti, and the relationship between these uses
and young's self-reported levels of addiction towards Tuenti. Also, the
students' attitudes towards the presence of their parents as contacts in
Tuenti, and the impact of gender were analyzed. The results showed four
different categories of uses: entertainment, public communication,
private communication and social information. Also, young's positive
attitude toward the presence of the mother in Tuenti played a protective
role in their addition levels towards this social networking site.
Finally, statistically significant gender differences in the uses of
Tuenti and also in their addiction levels toward Tuenti were found.},
