@article{WOS:000351932200005,
 abstract = {This is a multiple methods study that highlights the tension between
awareness- and behavioral-based campaign successes, particularly when
communicating using social media and pop-culture-referencing humor. To
illustrate, it examines the Centers for Disease Control and Prevention's
(CDC) ``zombie apocalypse{''} all-disaster-preparedness campaign. An
interview with a CDC campaign manager, campaign document analysis, and a
2 (information form: social vs. traditional media) x 2 (message
strategy: humorous vs. non-humorous) experiment uncovers benefits and
pitfalls of using social media and humorous messaging for risk
communication. Findings show social media can quickly spread information
to new publics for minimal costs; however, experiment participants who
received the humorous (i.e., zombie) risk message reported significantly
weaker intentions to take protective actions in comparison to those who
received the traditional, non-humorous risk message.},
