@article{WOS:001406599900001,
 abstract = {Previous studies have shown that the use of information and
communication technology (ICT) reduces loneliness among older adults.
However, it remains unclear whether and how intelligent health
management technology (IHMT), designed to improve physical health,
influences loneliness among older adults with disabilities. This study
investigated the association between IHMT use and loneliness among older
adults with disabilities in China, as well as the potential mediating
effects of social networks on this relationship. A nationally
representative sample of older adults with disabilities aged 60 years or
older (N = 3,121) from the 2018 China Longitudinal Aging Social Survey
was analyzed. Path analysis was employed to model the relationships
among IHMT use, social networks, and loneliness. Findings indicated that
IHMT use was associated with lower levels of loneliness among older
adults with disabilities. Social networks mediated 6.58\% of the
association between IHMT use and loneliness among older adults with
disabilities. These results highlight the potential of IHMT devices in
mitigating loneliness and enhancing social connections among older
adults with disabilities.},
