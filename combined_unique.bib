@article{WOS:000559750200011,
 abstract = {As the number of users' social connections on social networking sites
increases, different types of role stress may occur for these users. We
conducted an empirical analysis of 312 WeChat Moments users, to obtain
insight into how perceived role stress (role conflict, role overload,
and role ambiguity) and different stress responses (impression
management vs. social fatigue) influence online self-disclosure
behaviors. The results suggest that role overload and role ambiguity
both had a suppressive effect on self-disclosure: Role ambiguity reduced
social networking site users' need to maintain a personal network
impression, whereas role overload increased their psychological fatigue
in relation to interpersonal interactions. Further, although role
conflict increased social fatigue, it also promoted the use of more
impression manage mentmeasures to promote self-disclosure. Theoretical
and practical implications of the study are discussed.},
